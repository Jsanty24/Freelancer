    {
      "name": "2. Proyectos y Postulaciones (Gateway + API 2 Python)",
      "item": [
        {
          "name": "POST /proyectos (Crear proyecto - CLIENTE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_cliente}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_proyecto\": \"Plataforma E-Commerce Microservicios\",\n  \"descripcion\": \"Desarrollo de API REST y pasarela\",\n  \"fecha_inicio\": \"2026-02-10\",\n  \"tecnologia\": {\n    \"lenguaje_principal\": \"Python / FastAPI\",\n    \"repositorio_url\": \"https://github.com/org/ecommerce\"\n  }\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/proyectos",
              "host": ["{{gateway_url}}"],
              "path": ["proyectos"]
            }
          }
        },
        {
          "name": "GET /proyectos (Listar proyectos con filtros)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/proyectos?limit=20&offset=0",
              "host": ["{{gateway_url}}"],
              "path": ["proyectos"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "GET /proyectos/:id/progreso (Consultar progreso)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_cliente}}" }],
            "url": {
              "raw": "{{gateway_url}}/proyectos/{{proyecto_id}}/progreso",
              "host": ["{{gateway_url}}"],
              "path": ["proyectos", "{{proyecto_id}}", "progreso"]
            }
          }
        },
        {
          "name": "POST /proyectos/:id/postulaciones (Postularse - TRABAJADOR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_trabajador}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tarifa_propuesta\": 65.00,\n  \"mensaje\": \"Especialista en arquitectura de microservicios y bases de datos relacionales.\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/proyectos/{{proyecto_id}}/postulaciones",
              "host": ["{{gateway_url}}"],
              "path": ["proyectos", "{{proyecto_id}}", "postulaciones"]
            }
          }
        },
        {
          "name": "PATCH /postulaciones/:id (Aceptar propuesta y crear asignación - CLIENTE)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_cliente}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"ACEPTADA\",\n  \"rol_en_proyecto\": \"Arquitecto Backend\",\n  \"crear_asignacion\": true\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/postulaciones/{{postulacion_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["postulaciones", "{{postulacion_id}}"]
            }
          }
        }
      ]
    },
    {
