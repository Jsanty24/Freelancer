# Conexion al motor de base de datos MySQL/MariaDB.
# Copiar este archivo como .env y ajustar los valores segun tu maquina.
# El archivo .env NO se sube al repositorio, este si sirve de referencia.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=plataforma_freelance

# Puerto e IP local en los que escucha el servidor Express (solo acceso desde el Gateway).
PORT=3000
HOST=127.0.0.1

# Clave interna compartida con el API Gateway (header X-Internal-Key)
INTERNAL_API_KEY=clave-interna-gateway-freelancer-2026
