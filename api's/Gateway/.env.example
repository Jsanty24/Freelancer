# Puerto en el que escucha el API Gateway (único punto de entrada para el Frontend)
PORT=4000

# URLs internas de los 3 microservicios (escuchando en localhost)
PHP_API_URL=http://127.0.0.1:8000
PYTHON_API_URL=http://127.0.0.1:5000
EXPRESS_API_URL=http://127.0.0.1:3000

# Clave interna aleatoria de al menos 32 caracteres; usa el mismo valor en todos los servicios.
INTERNAL_API_KEY=

# Secreto aleatorio de al menos 32 caracteres para firmar los tokens JWT.
JWT_SECRET=
JWT_EXPIRES_SECONDS=86400

# Credenciales del administrador; la contraseña debe tener al menos 16 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
