# Puerto en el que escucha el API Gateway (único punto de entrada para el Frontend)
PORT=4000

# URLs internas de los 3 microservicios (escuchando en localhost)
PHP_API_URL=http://127.0.0.1:8000
PYTHON_API_URL=http://127.0.0.1:5000
EXPRESS_API_URL=http://127.0.0.1:3000

# Clave interna compartida que el Gateway envia en el header X-Internal-Key
INTERNAL_API_KEY=clave-interna-gateway-freelancer-2026

# Secreto para firmar los tokens JWT de sesion del Frontend
JWT_SECRET=cambie-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRES_SECONDS=86400
