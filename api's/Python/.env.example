# Copia este archivo a .env y completa los valores.
# .env NO se sube al repositorio (esta en el .gitignore).

# Cadena de conexion SQLAlchemy (driver, usuario, contraseña, servidor, puerto y base de datos)
DATABASE_URL=mysql+pymysql://USUARIO:CONTRASENA@localhost:3306/plataforma_freelance

# Puerto del servidor (se usa al ejecutar: python main.py)
PORT=5000

# Secreto compartido con las demas APIs para verificar los tokens JWT (HS256).
# Debe ser identico en la API PHP, la API Node y esta.
JWT_SECRET=cambie-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
